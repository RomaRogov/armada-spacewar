+#endif /* __LINUX_FOCALTECH_CORE_H__ */
--- a/drivers/input/touchscreen/focaltech_touch_ft3658u/focaltech_esdcheck.c
+++ b/drivers/input/touchscreen/focaltech_touch_ft3658u/focaltech_esdcheck.c
@@ -0,0 +1,465 @@
+/*
