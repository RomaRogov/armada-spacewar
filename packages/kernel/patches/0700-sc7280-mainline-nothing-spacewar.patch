+
+#define TFA987X_SYS_CTRL1		0x01
+#define TFA987X_SYS_CTRL1_MANSCONF_MSK	BIT(2)
+#define TFA987X_SYS_CTRL1_MANSAOOSC_MSK	BIT(4)
