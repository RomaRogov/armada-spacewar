+struct ft_chip_id_t {
+	u16 type;
+	u16 chip_ids[FTS_MAX_CHIP_IDS];
+};
+
+struct ts_ic_info {
+	bool is_incell;
+	bool hid_supported;
+	struct ft_chip_t ids;
+	struct ft_chip_id_t cid;
+};
